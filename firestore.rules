rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The whole game lives in one document, and every change is checked by the
    // game engine in the app. Rules are open so players can trade without
    // signing in. Fine for a friendly tournament; see README for the limits.
    match /silverball/{doc} {
      allow read, write: if true;
    }
  }
}
